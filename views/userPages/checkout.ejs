                                                                <img class="padding-25px-top xs-padding-5px-top"
                                                                    src="assets/images/payment-img.jpg" alt="card"
                                                                    title="card" />
                                                            </div>
                                                        </div>
                                                    </fieldset>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
